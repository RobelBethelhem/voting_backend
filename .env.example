# Copy to .env and fill in. .env is not committed.

# MongoDB connection string
DB=mongodb://127.0.0.1:27017/voting_system

# bcrypt salt rounds and JWT signing secrets. Use long random values, different on every server:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SALT=10
ACCESS_TOKEN_PRIVATE_KEY=change-me
REFRESH_TOKEN_PRIVATE_KEY=change-me-too

# Local development only. Under IIS, iisnode sets PORT itself (a named pipe).
PORT=5000

# Path the API is served under. Locally /api; on IIS it must match the application path
# (frontend: VITE_API_BASE / src/api/base.js).
API_PREFIX=/api
# API_PREFIX=/zbvs/api

# Origins allowed to call the API (comma-separated). Leave empty to allow any (development).
CORS_ORIGINS=
# CORS_ORIGINS=https://aps2.zemenbank.com

# Login
#   ldap  - Zemen Bank domain accounts (Active Directory). Default when unset; use on the server.
#   local - development: any account with the test passwords 1234 / test123 / admin123.
AUTH_MODE=local
# AUTH_MODE=ldap
LDAP_URL=ldap://mbdcp06.zemenbank.local:389
LDAP_DOMAIN=Zemenbank
EMAIL_DOMAIN=zemenbank.com
# Every API call needs a signed-in user. On by default with AUTH_MODE=ldap; set false/true to override.
# REQUIRE_SIGN_IN=true
# Accounts outside the bank email domain (not in AD) that may still sign in with their own
# password in ldap mode. Admins only; set the password with: node scripts/setPassword.js <email>
LOCAL_ADMIN_EMAILS=admin@votingsystem.com
