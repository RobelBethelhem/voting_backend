<?xml version="1.0" encoding="utf-8"?>
<!-- IIS + iisnode configuration for the voting API (see DEPLOY_IIS.md).
     The IIS application path (e.g. /zbvs/api) must match API_PREFIX in .env. -->
<configuration>
  <system.webServer>
    <!-- Remove WebDAV which blocks PUT/DELETE -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>

    <!-- run.cjs is the Node.js application handled by the iisnode module -->
    <handlers>
      <remove name="WebDAV" />
      <add name="iisnode" path="run.cjs" verb="*" modules="iisnode" />
    </handlers>

    <!-- Send every request to run.cjs -->
    <rewrite>
      <rules>
        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}" />
        </rule>

        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="run.cjs" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Excel imports post up to 25 MB of JSON (BODY_LIMIT in app.js) -->
        <requestLimits maxAllowedContentLength="31457280" />
        <!-- Never serve the secrets, dependencies or iisnode logs -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
        <!-- Allow PUT and DELETE verbs -->
        <verbs>
          <add verb="GET" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="PUT" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="PATCH" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <!-- Make sure error responses are left untouched -->
    <httpErrors existingResponse="PassThrough" />

    <!-- Production: no remote debugger and no stack traces in responses.
         Logs are written to the iisnode folder next to this file. -->
    <iisnode
      nodeProcessCommandLine="node"
      debuggingEnabled="false"
      loggingEnabled="true"
      devErrorsEnabled="false"
      watchedFiles="*.js;.env"
    />

    <staticContent>
      <remove fileExtension=".cjs" />
      <mimeMap fileExtension=".cjs" mimeType="application/node" />
    </staticContent>
  </system.webServer>
</configuration>
